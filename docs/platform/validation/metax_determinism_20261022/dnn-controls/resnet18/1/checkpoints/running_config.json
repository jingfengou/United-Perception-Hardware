{
  "num_classes": 10,
  "runtime": {
    "task_names": "cls",
    "device": "cuda:0",
    "random_seed": 131,
    "accelerator": {
      "backend": "metax",
      "numerics": "native"
    },
    "iter_base": true,
    "rank_init": false,
    "aligned": false,
    "async_norm": false,
    "special_bn_init": false,
    "model_helper": {
      "type": "base",
      "kwargs": {}
    }
  },
  "random_resized_crop": {
    "type": "torch_random_resized_crop",
    "kwargs": {
      "size": 64,
      "scale": [
        0.08,
        1
      ]
    }
  },
  "random_horizontal_flip": {
    "type": "torch_random_horizontal_flip"
  },
  "pil_color_jitter": {
    "type": "torch_color_jitter",
    "kwargs": {
      "brightness": 0.2,
      "contrast": 0.2,
      "saturation": 0.2,
      "hue": 0.1
    }
  },
  "center_crop": {
    "type": "torch_center_crop",
    "kwargs": {
      "size": 64
    }
  },
  "torch_size": {
    "type": "torch_resize",
    "kwargs": {
      "size": 72
    }
  },
  "to_tensor": {
    "type": "to_tensor"
  },
  "normalize": {
    "type": "normalize",
    "kwargs": {
      "mean": [
        0.485,
        0.456,
        0.406
      ],
      "std": [
        0.229,
        0.224,
        0.225
      ]
    }
  },
  "dataset": {
    "train": {
      "dataset": {
        "type": "cls",
        "kwargs": {
          "meta_file": "/workspace/up-run/platform-determinism-20261022/data/cifar10-train.txt",
          "image_reader": {
            "type": "fs_pillow",
            "kwargs": {
              "image_dir": "/workspace/up-cross-vendor-20261021/data/cifar10/train",
              "color_mode": "RGB"
            }
          },
          "transformer": [
            {
              "type": "torch_random_resized_crop",
              "kwargs": {
                "size": 64,
                "scale": [
                  0.08,
                  1
                ]
              }
            },
            {
              "type": "torch_random_horizontal_flip"
            },
            {
              "type": "torch_color_jitter",
              "kwargs": {
                "brightness": 0.2,
                "contrast": 0.2,
                "saturation": 0.2,
                "hue": 0.1
              }
            },
            {
              "type": "to_tensor"
            },
            {
              "type": "normalize",
              "kwargs": {
                "mean": [
                  0.485,
                  0.456,
                  0.406
                ],
                "std": [
                  0.229,
                  0.224,
                  0.225
                ]
              }
            }
          ]
        }
      },
      "batch_sampler": {
        "type": "base",
        "kwargs": {
          "sampler": {
            "type": "dist",
            "kwargs": {}
          },
          "batch_size": 2
        }
      },
      "dataloader": {
        "type": "cls_base",
        "kwargs": {
          "num_workers": 0,
          "pin_memory": true
        }
      }
    },
    "test": {
      "dataset": {
        "type": "cls",
        "kwargs": {
          "meta_file": "/workspace/up-run/platform-determinism-20261022/data/cifar10-test.txt",
          "image_reader": {
            "type": "fs_pillow",
            "kwargs": {
              "image_dir": "/workspace/up-cross-vendor-20261021/data/cifar10/test",
              "color_mode": "RGB"
            }
          },
          "transformer": [
            {
              "type": "torch_resize",
              "kwargs": {
                "size": 72
              }
            },
            {
              "type": "torch_center_crop",
              "kwargs": {
                "size": 64
              }
            },
            {
              "type": "to_tensor"
            },
            {
              "type": "normalize",
              "kwargs": {
                "mean": [
                  0.485,
                  0.456,
                  0.406
                ],
                "std": [
                  0.229,
                  0.224,
                  0.225
                ]
              }
            }
          ],
          "evaluator": {
            "type": "imagenet",
            "kwargs": {
              "topk": [
                1,
                5
              ]
            }
          }
        }
      },
      "batch_sampler": {
        "type": "base",
        "kwargs": {
          "sampler": {
            "type": "dist",
            "kwargs": {}
          },
          "batch_size": 2
        }
      },
      "dataloader": {
        "type": "cls_base",
        "kwargs": {
          "num_workers": 0,
          "pin_memory": true
        }
      }
    },
    "builder_type": "base",
    "data_pool": [
      "train:train",
      "test:test"
    ]
  },
  "trainer": {
    "max_epoch": 3,
    "test_freq": 2,
    "save_freq": 1000,
    "only_save_latest": false,
    "optimizer": {
      "type": "SGD",
      "kwargs": {
        "lr": 0.05,
        "nesterov": true,
        "momentum": 0.9,
        "weight_decay": 0.0001
      }
    },
    "lr_scheduler": {
      "warmup_iter": 0,
      "warmup_type": "linear",
      "warmup_register_type": "no_scale_lr",
      "warmup_ratio": 0.25,
      "type": "MultiStepLR",
      "kwargs": {
        "milestones": [
          1,
          2
        ],
        "gamma": 0.1
      }
    },
    "max_iter": 3,
    "test_start": 0
  },
  "saver": {
    "auto_resume": false,
    "save_result": true,
    "save_dir": "/workspace/up-run/platform-determinism-20261022/dnn-controls/resnet18/1/checkpoints",
    "results_dir": "/workspace/up-run/platform-determinism-20261022/dnn-controls/resnet18/1/predictions"
  },
  "hooks": [
    {
      "type": "train_val_logger",
      "kwargs": {
        "freq": 50,
        "skip_first_k": 5,
        "logdir": "log"
      }
    }
  ],
  "net": [
    {
      "name": "backbone",
      "type": "resnet18",
      "kwargs": {
        "frozen_layers": [],
        "out_layers": [
          4
        ],
        "out_strides": [
          32
        ],
        "normalize": {
          "type": "solo_bn"
        },
        "initializer": {
          "method": "msra"
        }
      }
    },
    {
      "name": "head",
      "type": "base_cls_head",
      "kwargs": {
        "num_classes": 10,
        "in_plane": 512,
        "input_feature_idx": -1
      }
    },
    {
      "name": "post_process",
      "type": "base_cls_postprocess",
      "kwargs": {
        "cls_loss": {
          "type": "label_smooth_ce",
          "kwargs": {
            "smooth_ratio": 0.1,
            "num_classes": 10
          }
        }
      }
    }
  ],
  "args": {
    "backend": "dist",
    "display": 50,
    "no_running_config": true,
    "nocudnn": true
  }
}