{
  "num_classes": 2,
  "runtime": {
    "aligned": true,
    "rank_init": true,
    "task_names": "det",
    "device": "cuda:0",
    "random_seed": 131,
    "accelerator": {
      "backend": "nvidia",
      "numerics": "native"
    },
    "iter_base": true,
    "async_norm": false,
    "special_bn_init": false,
    "model_helper": {
      "type": "base",
      "kwargs": {}
    }
  },
  "mosaic": {
    "type": "mosaic",
    "kwargs": {
      "extra_input": true,
      "mosaic_prob": 1.0,
      "tar_size": 320,
      "fill_color": 0
    }
  },
  "random_perspective": {
    "type": "random_perspective",
    "kwargs": {
      "degrees": 0.0,
      "translate": 0.1,
      "scale": 0.5,
      "shear": 0.0,
      "perspective": 0.0,
      "fill_color": 0,
      "border": [
        -160,
        -160
      ]
    }
  },
  "augment_hsv": {
    "type": "augment_hsv",
    "kwargs": {
      "hgain": 0.015,
      "sgain": 0.7,
      "vgain": 0.4
    }
  },
  "flip": {
    "type": "flip",
    "kwargs": {
      "flip_p": 0.5
    }
  },
  "to_tensor": {
    "type": "to_tensor",
    "kwargs": {}
  },
  "resize": {
    "type": "keep_ar_resize_max",
    "kwargs": {
      "max_size": 320
    }
  },
  "dataset": {
    "train": {
      "dataset": {
        "type": "coco",
        "kwargs": {
          "meta_file": "/workspace/up-platform-validation-20261022/run-01/data/pennfudan-train.json",
          "image_reader": {
            "type": "fs_opencv",
            "kwargs": {
              "image_dir": "/workspace/up-cross-vendor-20261021/data/pennfudan/images",
              "color_mode": "RGB"
            }
          },
          "transformer": [
            {
              "type": "mosaic",
              "kwargs": {
                "extra_input": true,
                "mosaic_prob": 1.0,
                "tar_size": 320,
                "fill_color": 0
              }
            },
            {
              "type": "random_perspective",
              "kwargs": {
                "degrees": 0.0,
                "translate": 0.1,
                "scale": 0.5,
                "shear": 0.0,
                "perspective": 0.0,
                "fill_color": 0,
                "border": [
                  -160,
                  -160
                ]
              }
            },
            {
              "type": "augment_hsv",
              "kwargs": {
                "hgain": 0.015,
                "sgain": 0.7,
                "vgain": 0.4
              }
            },
            {
              "type": "flip",
              "kwargs": {
                "flip_p": 0.5
              }
            },
            {
              "type": "to_tensor",
              "kwargs": {}
            }
          ]
        }
      },
      "batch_sampler": {
        "type": "base",
        "kwargs": {
          "sampler": {
            "type": "dist",
            "kwargs": {}
          },
          "batch_size": 2
        }
      },
      "dataloader": {
        "type": "base",
        "kwargs": {
          "num_workers": 0,
          "alignment": 32,
          "pad_type": "center_pad",
          "pad_value": 0,
          "pin_memory": true
        }
      }
    },
    "test": {
      "dataset": {
        "type": "coco",
        "kwargs": {
          "meta_file": "/workspace/up-platform-validation-20261022/run-01/data/pennfudan-test.json",
          "image_reader": {
            "type": "fs_opencv",
            "kwargs": {
              "image_dir": "/workspace/up-cross-vendor-20261021/data/pennfudan/images",
              "color_mode": "RGB"
            }
          },
          "transformer": [
            {
              "type": "keep_ar_resize_max",
              "kwargs": {
                "max_size": 320
              }
            },
            {
              "type": "to_tensor",
              "kwargs": {}
            }
          ],
          "evaluator": {
            "type": "COCO",
            "kwargs": {
              "gt_file": "/workspace/up-platform-validation-20261022/run-01/data/pennfudan-test.json",
              "iou_types": [
                "bbox"
              ]
            }
          }
        }
      },
      "batch_sampler": {
        "type": "base",
        "kwargs": {
          "sampler": {
            "type": "dist",
            "kwargs": {}
          },
          "batch_size": 2
        }
      },
      "dataloader": {
        "type": "base",
        "kwargs": {
          "num_workers": 0,
          "alignment": 32,
          "pad_type": "center_pad",
          "pad_value": 0,
          "pin_memory": true
        }
      }
    },
    "batch_sampler": {
      "type": "base",
      "kwargs": {
        "sampler": {
          "type": "dist",
          "kwargs": {}
        },
        "batch_size": 64
      }
    },
    "dataloader": {
      "type": "base",
      "kwargs": {
        "num_workers": 0,
        "alignment": 32,
        "pad_type": "center_pad",
        "pad_value": 0,
        "pin_memory": true
      }
    },
    "builder_type": "base",
    "data_pool": [
      "train:train",
      "test:test"
    ]
  },
  "trainer": {
    "max_epoch": 3,
    "save_freq": 1000,
    "test_freq": 2,
    "optimizer": {
      "type": "SGD",
      "kwargs": {
        "lr": 0.00015625,
        "momentum": 0.937,
        "nesterov": true,
        "weight_decay": 0.0005
      }
    },
    "lr_scheduler": {
      "warmup_register_type": "yolov5",
      "warmup_epochs": 3,
      "warmup_iter": 0,
      "warmup_type": "yolov5linear",
      "type": "YoloV5CosineLR",
      "kwargs": {
        "T_max": 3,
        "min_lr_scale": 0.2
      },
      "warmup_total_epochs": 3
    },
    "only_save_latest": false,
    "max_iter": 3,
    "test_start": 0
  },
  "saver": {
    "auto_resume": false,
    "save_result": true,
    "save_dir": "/workspace/up-platform-validation-20261022/run-01/baseline/yolov5s/training/checkpoints",
    "results_dir": "/workspace/up-platform-validation-20261022/run-01/baseline/yolov5s/training/predictions"
  },
  "ema": {
    "enable": false,
    "ema_type": "exp",
    "kwargs": {
      "decay": 0.9999
    }
  },
  "net": [
    {
      "name": "backbone",
      "type": "DarkNetv5",
      "kwargs": {
        "init_planes": 32,
        "csp1_block_nums": [
          1,
          3,
          3,
          1
        ],
        "out_layers": [
          2,
          3,
          4
        ],
        "out_strides": [
          8,
          16,
          32
        ],
        "focus_type": "v5_focus",
        "normalize": {
          "type": "solo_bn"
        },
        "act_fn": {
          "type": "Silu",
          "kwargs": {
            "inplace": true
          }
        },
        "initializer": {
          "method": "yolov5_init"
        }
      }
    },
    {
      "name": "neck",
      "prev": "backbone",
      "type": "DarknetPAFPN",
      "kwargs": {
        "csp2_block_nums": 1,
        "num_outs": 3,
        "out_strides": [
          8,
          16,
          32
        ],
        "normalize": {
          "type": "solo_bn"
        },
        "act_fn": {
          "type": "Silu",
          "kwargs": {
            "inplace": true
          }
        },
        "initializer": {
          "method": "yolov5_init"
        },
        "inplanes": [
          128,
          256,
          512
        ]
      }
    },
    {
      "name": "head",
      "prev": "neck",
      "type": "YoloV5Head",
      "kwargs": {
        "num_classes": 2,
        "num_level": 3,
        "num_anchors_per_level": 3,
        "out_strides": [
          8,
          16,
          32
        ],
        "initializer": {
          "method": "yolov5_init"
        },
        "inplanes": [
          128,
          256,
          512
        ]
      }
    },
    {
      "name": "post_process",
      "prev": "head",
      "type": "yolov5_post",
      "kwargs": {
        "num_classes": 2,
        "num_level": 3,
        "num_anchors_per_level": 3,
        "out_strides": [
          8,
          16,
          32
        ],
        "loss_weights": [
          0.05,
          1.0,
          0.5
        ],
        "obj_loss_layer_weights": [
          4.0,
          1.0,
          0.4
        ],
        "initializer": {
          "method": "yolov5_init"
        },
        "cfg": {
          "anchor_generator": {
            "type": "cluster",
            "kwargs": {
              "base_anchors_file": "/workspace/up-cross-vendor-20261021/data/weights/yolov5-anchors.json",
              "num_level": 3,
              "num_anchors_per_level": 3
            }
          },
          "roi_supervisor": {
            "type": "yolov5",
            "kwargs": {
              "strides": [
                8,
                16,
                32
              ],
              "num_classes": 1
            }
          },
          "roi_predictor": {
            "type": "yolov5",
            "kwargs": {
              "roi_min_size": 2,
              "conf_thres": 0.001,
              "merger": {
                "type": "yolov5",
                "kwargs": {
                  "top_n": 300,
                  "nms": {
                    "type": "naive",
                    "nms_iou_thresh": 0.6
                  }
                }
              },
              "strides": [
                8,
                16,
                32
              ],
              "single_cls": true
            }
          },
          "obj_loss": {
            "type": "sigmoid_cross_entropy",
            "kwargs": {
              "reduction": "none"
            }
          },
          "box_loss": {
            "type": "iou_loss",
            "kwargs": {
              "loss_type": "ciou",
              "reduction": "none"
            }
          },
          "cls_loss": {
            "type": "sigmoid_cross_entropy",
            "kwargs": {
              "reduction": "none"
            }
          }
        }
      }
    }
  ],
  "args": {
    "backend": "dist",
    "display": 50,
    "no_running_config": true
  },
  "hooks": [
    {
      "type": "train_val_logger",
      "kwargs": {
        "freq": 50,
        "skip_first_k": 5,
        "logdir": "log"
      }
    }
  ]
}