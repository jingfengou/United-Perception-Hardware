{
  "num_classes": 10,
  "runtime": {
    "task_names": "cls",
    "device": "cuda:0",
    "random_seed": 131,
    "accelerator": {
      "backend": "nvidia",
      "numerics": "native"
    },
    "iter_base": true,
    "rank_init": false,
    "aligned": false,
    "async_norm": false,
    "special_bn_init": false,
    "model_helper": {
      "type": "base",
      "kwargs": {}
    }
  },
  "random_resized_crop": {
    "type": "torch_random_resized_crop",
    "kwargs": {
      "size": 64,
      "scale": [
        0.08,
        1
      ]
    }
  },
  "auto_augment": {
    "type": "torch_auto_augmentation",
    "kwargs": {
      "size": 64,
      "scale": [
        0.08,
        1
      ]
    }
  },
  "center_crop": {
    "type": "torch_center_crop",
    "kwargs": {
      "size": 64
    }
  },
  "torch_size": {
    "type": "torch_resize",
    "kwargs": {
      "size": 72
    }
  },
  "to_tensor": {
    "type": "to_tensor",
    "kwargs": {}
  },
  "normalize": {
    "type": "normalize",
    "kwargs": {
      "mean": [
        0.5,
        0.5,
        0.5
      ],
      "std": [
        0.5,
        0.5,
        0.5
      ]
    }
  },
  "dataset": {
    "train": {
      "dataset": {
        "type": "cls",
        "kwargs": {
          "meta_file": "/workspace/up-platform-validation-20261022/run-01/data/cifar10-train.txt",
          "image_reader": {
            "type": "fs_pillow",
            "kwargs": {
              "image_dir": "/workspace/up-cross-vendor-20261021/data/cifar10/train",
              "color_mode": "RGB",
              "memcached": false
            }
          },
          "transformer": [
            {
              "type": "torch_random_resized_crop",
              "kwargs": {
                "size": 64,
                "scale": [
                  0.08,
                  1
                ]
              }
            },
            {
              "type": "torch_auto_augmentation",
              "kwargs": {
                "size": 64,
                "scale": [
                  0.08,
                  1
                ]
              }
            },
            {
              "type": "to_tensor",
              "kwargs": {}
            },
            {
              "type": "normalize",
              "kwargs": {
                "mean": [
                  0.5,
                  0.5,
                  0.5
                ],
                "std": [
                  0.5,
                  0.5,
                  0.5
                ]
              }
            }
          ]
        }
      },
      "batch_sampler": {
        "type": "base",
        "kwargs": {
          "sampler": {
            "type": "dist",
            "kwargs": {}
          },
          "batch_size": 2
        }
      },
      "dataloader": {
        "type": "cls_base",
        "kwargs": {
          "num_workers": 0,
          "pin_memory": true,
          "batch_fn": {
            "type": "batch_cutmixup",
            "kwargs": {
              "mixup_alpha": 0.8,
              "cutmix_alpha": 1.0,
              "switch_prob": 0.5,
              "num_classes": 10
            }
          }
        }
      }
    },
    "test": {
      "dataset": {
        "type": "cls",
        "kwargs": {
          "meta_file": "/workspace/up-platform-validation-20261022/run-01/data/cifar10-test.txt",
          "image_reader": {
            "type": "fs_pillow",
            "kwargs": {
              "image_dir": "/workspace/up-cross-vendor-20261021/data/cifar10/test",
              "color_mode": "RGB",
              "memcached": false
            }
          },
          "transformer": [
            {
              "type": "torch_resize",
              "kwargs": {
                "size": 72
              }
            },
            {
              "type": "torch_center_crop",
              "kwargs": {
                "size": 64
              }
            },
            {
              "type": "to_tensor",
              "kwargs": {}
            },
            {
              "type": "normalize",
              "kwargs": {
                "mean": [
                  0.5,
                  0.5,
                  0.5
                ],
                "std": [
                  0.5,
                  0.5,
                  0.5
                ]
              }
            }
          ],
          "evaluator": {
            "type": "imagenet",
            "kwargs": {
              "topk": [
                1,
                5
              ]
            }
          }
        }
      },
      "batch_sampler": {
        "type": "base",
        "kwargs": {
          "sampler": {
            "type": "dist",
            "kwargs": {}
          },
          "batch_size": 2
        }
      },
      "dataloader": {
        "type": "cls_base",
        "kwargs": {
          "num_workers": 0,
          "pin_memory": true
        }
      }
    },
    "builder_type": "base",
    "data_pool": [
      "train:train",
      "test:test"
    ]
  },
  "trainer": {
    "max_epoch": 3,
    "test_freq": 2,
    "save_freq": 1000,
    "only_save_latest": false,
    "optimizer": {
      "type": "AdamW",
      "kwargs": {
        "lr": 0.00075,
        "weight_decay": 0.05
      }
    },
    "lr_scheduler": {
      "warmup_iter": 157,
      "warmup_type": "linear",
      "warmup_register_type": "no_scale_lr",
      "warmup_ratio": 0.01,
      "type": "CosineLREpochScheduler",
      "kwargs": {
        "T_max": 3,
        "eta_min": 1e-06,
        "warm_epoch": 1
      }
    },
    "max_iter": 3,
    "test_start": 0
  },
  "saver": {
    "auto_resume": false,
    "save_result": true,
    "save_dir": "/workspace/up-platform-validation-20261022/run-01/baseline/vit_b16/training/checkpoints",
    "results_dir": "/workspace/up-platform-validation-20261022/run-01/baseline/vit_b16/training/predictions"
  },
  "hooks": [
    {
      "type": "train_val_logger",
      "kwargs": {
        "freq": 50,
        "skip_first_k": 5,
        "logdir": "log"
      }
    }
  ],
  "net": [
    {
      "name": "backbone",
      "type": "vit_base_patch16_224",
      "kwargs": {
        "drop_path": 0.1,
        "dropout": 0.1,
        "attention_dropout": 0.1,
        "qkv_bias": true,
        "image_size": 64
      }
    },
    {
      "name": "head",
      "type": "vit_head",
      "kwargs": {
        "num_classes": 10,
        "in_plane": 768,
        "input_feature_idx": -1
      }
    },
    {
      "name": "post_process",
      "type": "base_cls_postprocess",
      "kwargs": {
        "cls_loss": {
          "type": "label_smooth_ce",
          "kwargs": {
            "smooth_ratio": 0.1,
            "num_classes": 10
          }
        }
      }
    }
  ],
  "args": {
    "backend": "dist",
    "display": 50,
    "no_running_config": true
  }
}